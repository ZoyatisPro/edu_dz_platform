APP_NAME=edu_dz_platform
APP_DISPLAY_NAME="منصة الأستاذة هاجر"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Algiers

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

# Compte administrateur principal (seeders)
ADMIN_NAME="Administrateur"
ADMIN_EMAIL=admin@edu-dz.test
ADMIN_PASSWORD=password

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=edu_dz_platform
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Stockage objet (Cloudflare R2 / S3) ---
# En développement on utilise le disque local « local ».
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_URL=

# --- Sécurité ---
# Cloudflare Turnstile (laisser vide pour désactiver en local)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Réseaux sociaux ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
FACEBOOK_PAGE_ID=
FACEBOOK_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
THREADS_ACCOUNT_ID=
YOUTUBE_CHANNEL_ID=
TIKTOK_ACCESS_TOKEN=

# --- Fournisseurs IA (laisser vide pour désactiver) ---
AI_PROVIDER=groq
AI_TIMEOUT=30
AI_DAILY_QUOTA=20
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Surveillance ---
SENTRY_LARAVEL_DSN=

VITE_APP_NAME="${APP_NAME}"
